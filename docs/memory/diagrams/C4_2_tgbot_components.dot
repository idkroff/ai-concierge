digraph C4_components {
  graph [label=<<B>tg_bot · фича «Память» · C4 уровень 3: за что отвечает каждый компонент</B><BR/><FONT POINT-SIZE="11">серый: без изменений · жёлтый: меняется · зелёный: новое</FONT>>, labelloc=t, fontname="Helvetica", fontsize=16, rankdir=TB, nodesep=0.35, ranksep=0.6, pad=0.4, bgcolor=white, splines=true];
  node  [shape=plain, fontname="Helvetica", fontsize=10];
  edge  [fontname="Helvetica", fontsize=8, color="#555555", fontcolor="#333333", arrowsize=0.7];

  tg     [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#9e9e9e" COLOR="#616161" STYLE="rounded"><TR><TD><FONT COLOR="white" POINT-SIZE="12"><B>Telegram</B></FONT><BR/><FONT COLOR="#eeeeee" POINT-SIZE="8">[внешняя система · без изменений]</FONT><BR/><FONT COLOR="white">Через него пользователь пишет боту<BR/>и нажимает кнопки</FONT></TD></TR></TABLE>>];
  caller [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#9e9e9e" COLOR="#616161" STYLE="rounded"><TR><TD><FONT COLOR="white" POINT-SIZE="12"><B>caller_service · сервис звонков</B></FONT><BR/><FONT COLOR="#eeeeee" POINT-SIZE="8">[наш сервис · без изменений]</FONT><BR/><FONT COLOR="white">Звонит в ресторан голосом и сообщает,<BR/>чем закончился разговор</FONT></TD></TR></TABLE>>];
  ydb    [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#f2c14e" COLOR="#b8860b" STYLE="rounded"><TR><TD><FONT POINT-SIZE="12"><B>YDB · база данных</B></FONT><BR/><FONT POINT-SIZE="8">[меняется: новые таблицы]</FONT><BR/>Сейчас: пользователи и лимиты звонков.<BR/>Добавляются: брони, их история, пожелания,<BR/>записи разговоров, события для метрик</TD></TR></TABLE>>];
  llm    [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#4caf50" COLOR="#2e7d32" STYLE="rounded"><TR><TD><FONT COLOR="white" POINT-SIZE="12"><B>Языковая модель · Yandex AI Studio</B></FONT><BR/><FONT COLOR="#e8f5e9" POINT-SIZE="8">[внешняя система · новое]</FONT><BR/><FONT COLOR="white">Понимает фразы пользователя, замечает<BR/>пожелания, читает запись разговора</FONT></TD></TR></TABLE>>];
  emb    [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#4caf50" COLOR="#2e7d32" STYLE="rounded"><TR><TD><FONT COLOR="white" POINT-SIZE="12"><B>Сравнение смысла · Yandex AI Studio</B></FONT><BR/><FONT COLOR="#e8f5e9" POINT-SIZE="8">[внешняя система · новое]</FONT><BR/><FONT COLOR="white">Помогает понять, что «тихий зал» и «где потише»<BR/>это одно и то же пожелание</FONT></TD></TR></TABLE>>];

  subgraph cluster_tgbot {
    label=<<B>tg_bot · Telegram-бот</B>  <FONT POINT-SIZE="10">[наш сервис на Go · здесь живёт вся фича]</FONT>>; labeljust=l; fontname="Helvetica"; fontsize=12; style="dashed,rounded"; color="#444444"; margin=16;

    handler [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#f2c14e" COLOR="#b8860b" STYLE="rounded"><TR><TD><FONT POINT-SIZE="12"><B>Обработчик Telegram</B></FONT><BR/><FONT POINT-SIZE="8">[есть · меняется]</FONT><BR/>Принимает сообщения и нажатия кнопок,<BR/>показывает экраны и отвечает пользователю.<BR/>Добавляются команды /bookings, /memory, /forget<BR/>и кнопки «Забыть», «Исправить», «Убрать»</TD></TR></TABLE>>];
    callu   [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#f2c14e" COLOR="#b8860b" STYLE="rounded"><TR><TD><FONT POINT-SIZE="12"><B>Сценарий новой брони</B></FONT><BR/><FONT POINT-SIZE="8">[есть · меняется немного]</FONT><BR/>Как сейчас: разобрать просьбу, показать<BR/>экран подтверждения, запустить звонок.<BR/>Теперь ещё подставляет пожелания из памяти</TD></TR></TABLE>>];
    session [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#f2c14e" COLOR="#b8860b" STYLE="rounded"><TR><TD><FONT POINT-SIZE="12"><B>Состояние диалога</B></FONT><BR/><FONT POINT-SIZE="8">[есть · меняется]</FONT><BR/>Помнит, на каком шаге сейчас пользователь:<BR/>ждём подтверждения, идёт звонок и т. п.<BR/>Добавляется: какое поручение выполняем</TD></TR></TABLE>>];
    userrepo [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#9e9e9e" COLOR="#616161" STYLE="rounded"><TR><TD><FONT COLOR="white" POINT-SIZE="12"><B>Пользователи и лимит звонков</B></FONT><BR/><FONT COLOR="#eeeeee" POINT-SIZE="8">[есть · без изменений]</FONT><BR/><FONT COLOR="white">Кто пользователь, его телефон,<BR/>сколько звонков сегодня уже потрачено (из 3)</FONT></TD></TR></TABLE>>];
    callerc [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#9e9e9e" COLOR="#616161" STYLE="rounded"><TR><TD><FONT COLOR="white" POINT-SIZE="12"><B>Связь с сервисом звонков</B></FONT><BR/><FONT COLOR="#eeeeee" POINT-SIZE="8">[есть · без изменений]</FONT><BR/><FONT COLOR="white">Передаёт задание на звонок и получает<BR/>ход разговора и его итог</FONT></TD></TR></TABLE>>];

    booking [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#4caf50" COLOR="#2e7d32" STYLE="rounded"><TR><TD><FONT COLOR="white" POINT-SIZE="12"><B>Сценарии с памятью о бронях</B></FONT><BR/><FONT COLOR="#e8f5e9" POINT-SIZE="8">[новое]</FONT><BR/><FONT COLOR="white">«Как в прошлый раз», перенос и отмена одной фразой.<BR/>Показывает «было → станет», после звонка<BR/>обновляет бронь и записывает историю</FONT></TD></TR></TABLE>>];
    intent  [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#4caf50" COLOR="#2e7d32" STYLE="rounded"><TR><TD><FONT COLOR="white" POINT-SIZE="12"><B>Понимание просьбы</B></FONT><BR/><FONT COLOR="#e8f5e9" POINT-SIZE="8">[новое · через языковую модель]</FONT><BR/><FONT COLOR="white">Определяет, чего хочет пользователь: новая бронь,<BR/>повтор, перенос или отмена, и какие детали назвал</FONT></TD></TR></TABLE>>];
    matcher [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#4caf50" COLOR="#2e7d32" STYLE="rounded"><TR><TD><FONT COLOR="white" POINT-SIZE="12"><B>Поиск нужной брони</B></FONT><BR/><FONT COLOR="#e8f5e9" POINT-SIZE="8">[новое]</FONT><BR/><FONT COLOR="white">Находит, о какой брони речь. Если подходит<BR/>несколько, просит выбрать; если бронь прошла<BR/>или её нет, честно говорит и не звонит</FONT></TD></TR></TABLE>>];
    outcome [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#4caf50" COLOR="#2e7d32" STYLE="rounded"><TR><TD><FONT COLOR="white" POINT-SIZE="12"><B>Оценка итога звонка</B></FONT><BR/><FONT COLOR="#e8f5e9" POINT-SIZE="8">[новое · через языковую модель]</FONT><BR/><FONT COLOR="white">По записи разговора решает: ресторан<BR/>согласился, отказал или не удалось дозвониться</FONT></TD></TR></TABLE>>];
    memory  [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#4caf50" COLOR="#2e7d32" STYLE="rounded"><TR><TD><FONT COLOR="white" POINT-SIZE="12"><B>Управление пожеланиями</B></FONT><BR/><FONT COLOR="#e8f5e9" POINT-SIZE="8">[новое]</FONT><BR/><FONT COLOR="white">Показывает, что бот помнит и откуда взял,<BR/>даёт исправить, забыть одно или стереть всё</FONT></TD></TR></TABLE>>];
    llmc    [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#4caf50" COLOR="#2e7d32" STYLE="rounded"><TR><TD><FONT COLOR="white" POINT-SIZE="12"><B>Связь с языковой моделью</B></FONT><BR/><FONT COLOR="#e8f5e9" POINT-SIZE="8">[новое]</FONT><BR/><FONT COLOR="white">Единая точка обращений к модели<BR/>и к сравнению смысла</FONT></TD></TR></TABLE>>];
    repos   [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#4caf50" COLOR="#2e7d32" STYLE="rounded"><TR><TD><FONT COLOR="white" POINT-SIZE="12"><B>Хранилище памяти</B></FONT><BR/><FONT COLOR="#e8f5e9" POINT-SIZE="8">[новое]</FONT><BR/><FONT COLOR="white">Читает и пишет в базу брони, историю, пожелания,<BR/>записи разговоров и события.<BR/>Каждый пользователь видит только своё</FONT></TD></TR></TABLE>>];

    subgraph cluster_workers {
      label=<<B>Фоновые помощники</B>  <FONT POINT-SIZE="9">[работают внутри того же бота, пользователя не задерживают]</FONT>>; labeljust=l; fontname="Helvetica"; fontsize=11; style="rounded"; color="#2e7d32"; bgcolor="#f1f8e9"; margin=12;
      extractor [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#4caf50" COLOR="#2e7d32" STYLE="rounded"><TR><TD><FONT COLOR="white" POINT-SIZE="12"><B>Запоминание пожеланий</B></FONT><BR/><FONT COLOR="#e8f5e9" POINT-SIZE="8">[новое · в фоне]</FONT><BR/><FONT COLOR="white">Читает сообщения и замечает постоянные пожелания:<BR/>«всегда прошу тихий зал». Разовые просьбы, здоровье<BR/>и других людей не запоминает. Не дублирует<BR/>уже известное, хранит историю изменений</FONT></TD></TR></TABLE>>];
      events    [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#4caf50" COLOR="#2e7d32" STYLE="rounded"><TR><TD><FONT COLOR="white" POINT-SIZE="12"><B>Журнал событий для метрик</B></FONT><BR/><FONT COLOR="#e8f5e9" POINT-SIZE="8">[новое · в фоне]</FONT><BR/><FONT COLOR="white">Записывает, сколько заняло поручение, подставились ли<BR/>пожелания, согласился ли ресторан. Из этого<BR/>считаются метрики пилота</FONT></TD></TR></TABLE>>];
      purge     [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#4caf50" COLOR="#2e7d32" STYLE="rounded"><TR><TD><FONT COLOR="white" POINT-SIZE="12"><B>Уборщик данных</B></FONT><BR/><FONT COLOR="#e8f5e9" POINT-SIZE="8">[новое · в фоне]</FONT><BR/><FONT COLOR="white">Если пользователь нажал «Удалить всё», физически<BR/>стирает его данные не позже чем через сутки</FONT></TD></TR></TABLE>>];
      { rank=same; extractor; events; purge; }
    }

    { rank=same; callu; booking; memory; }
    { rank=same; session; userrepo; callerc; intent; matcher; outcome; llmc; }
  }

  tg -> handler [label="сообщения, кнопки"];
  handler -> callu   [label="новая бронь"];
  handler -> booking [label="повтор, перенос, отмена"];
  handler -> memory  [label="команды и кнопки памяти"];
  handler -> events  [label="что нажал, что написал"];
  callu -> session;
  callu -> userrepo  [label="лимит"];
  callu -> callerc   [label="задание на звонок"];
  booking -> intent  [label="понять фразу"];
  booking -> matcher [label="найти бронь"];
  booking -> outcome [label="чем кончился звонок"];
  booking -> callerc [label="звонок с деталями брони"];
  booking -> userrepo [label="лимит"];
  booking -> session;
  booking -> repos   [label="брони, история"];
  booking -> events  [label="ход поручения"];
  memory -> extractor [label="сообщение в фон"];
  extractor -> llmc  [label="найти пожелания,\nсравнить смысл"];
  extractor -> repos [label="сохранить пожелание"];
  extractor -> events [label="что запомнили"];
  memory -> purge    [label="заявка «удалить всё»"];
  memory -> repos    [label="показать, исправить, забыть"];
  memory -> events   [label="что забыли"];
  intent -> llmc     [label="спросить модель"];
  outcome -> llmc    [label="спросить модель"];
  events -> repos    [label="записать"];
  purge -> repos     [label="стереть данные пользователя"];
  repos -> ydb;
  userrepo -> ydb;
  callerc -> caller;
  llmc -> llm;
  llmc -> emb;

  subgraph cluster_legend {
    label="Легенда"; fontname="Helvetica"; fontsize=10; style="rounded"; color="#999999"; margin=8;
    l0 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#9e9e9e" COLOR="#616161" STYLE="rounded"><TR><TD><FONT COLOR="white">без изменений</FONT></TD></TR></TABLE>>];
    l1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f2c14e" COLOR="#b8860b" STYLE="rounded"><TR><TD>меняется</TD></TR></TABLE>>];
    l2 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#4caf50" COLOR="#2e7d32" STYLE="rounded"><TR><TD><FONT COLOR="white">новое</FONT></TD></TR></TABLE>>];
    { rank=same; l0; l1; l2; }
    l0 -> l1 -> l2 [style=invis];
  }
}
